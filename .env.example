POSTGRES_DB=flourish
POSTGRES_USER=flourish
POSTGRES_PASSWORD=flourish_dev
DATABASE_URL=postgresql://flourish:flourish_dev@localhost:5432/flourish?schema=public

# Generate a unique local value; never reuse this example in production.
AUTH_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Use the same hostname for browsing and the Google callback registration.
NEXTAUTH_URL=http://localhost:3000

# Tests use dedicated shell variables, never the application DATABASE_URL.
# Follow README Testing and CI to provision guarded disposable targets.
# TEST_DATABASE_URL=postgresql://flourish_test:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:55433/flourish_test
# E2E_DATABASE_URL=postgresql://flourish_test:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:55434/flourish_e2e
